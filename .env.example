# alfa-credit-cabinet — environment template
# Copy to .env for local use. Never commit real secrets.

# Backend data (local default: backend/.data; Docker: /data)
DATA_DIR=
DATABASE_URL=sqlite:///./.data/app.db
UPLOADS_DIR=

# Comma-separated browser origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# Demo session secret (used from T02)
SESSION_SECRET=dev-session-secret-change-me

# Published ports (compose defaults)
# Backend: 8000
# Frontend (nginx): 8080
